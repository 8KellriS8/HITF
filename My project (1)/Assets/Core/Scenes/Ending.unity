  m_text: "\u0412\u044B \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442\u0435 \u0432
    \u043B\u0435\u0441\u0443 \u0435\u0449\u0451 \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u043E\u0435
    \u0432\u0440\u0435\u043C\u044F, \u043E\u0434\u043D\u0430\u043A\u043E \u0432\u0430\u0448\u0438
    \u043F\u043E\u0438\u0441\u043A\u0438 \u043D\u0435 \u0443\u0432\u0435\u043D\u0447\u0430\u043B\u0438\u0441\u044C
    \u0443\u0441\u043F\u0435\u0445\u043E\u043C.\n\u0421 \u043A\u0430\u043C\u043D\u0435\u043C
    \u043D\u0430 \u0441\u0435\u0440\u0434\u0446\u0435 \u0432\u044B \u0432\u044B\u0445\u043E\u0434\u0438\u0442\u0435
    \u0438\u0437 \u043B\u0435\u0441\u0430 \u0436\u0438\u0432\u044B\u043C, \u043D\u043E,
    \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u0432\u0441\u0451 \u0431\u044B\u043B\u043E
    \u0437\u0440\u044F.\n\n\u041C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C,
    \u0435\u0441\u043B\u0438 \u0431\u044B \u0432\u044B \u0431\u044B\u043B\u0438 \u0431\u044B\u0441\u0442\u0440\u0435\u0435,
